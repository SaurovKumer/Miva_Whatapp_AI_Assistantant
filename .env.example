# ==============================
# Miva demo environment settings
# ==============================
# Copy this file to .env and replace the demo values with your own.
# Never commit a real .env file or real API keys to GitHub.

# Required for @miva
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp owner number. Country code + number; spaces/+ signs are okay.
# Example only:
OWNER_NUMBER=8801XXXXXXXXX

# Gemini fallback chain (comma-separated)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Gemini request behavior
GEMINI_REQUEST_TIMEOUT_MS=25000
GEMINI_PRIMARY_COOLDOWN_MS=60000
GEMINI_NOT_FOUND_COOLDOWN_MS=600000

# Optional: required only for @miva_skill / Hermes routing
HERMES_API_KEY=your_hermes_gateway_key_here
HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=300000
